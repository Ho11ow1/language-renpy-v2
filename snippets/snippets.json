	"menu": {
		"prefix": "menu",
		"body": [
			"menu ${1/(.+)/ $1/}:",
			"\t$0"
		],
		"description": "Inserts an optionally named menu snippet\n"
	},
	"transform": {
		"prefix": "transform",
		"body": [
			"transform ${1:transformName}:",
			"\t$0"
		],
		"description": "Inserts a simple transform snippet\n"
