{
	"for": {
		"prefix": "for",
		"body": [ 
			"for ${1:i} in ${2:range(0, 5)}:",
			"\tprint(i)$0"
		],
		"description": "Inserts a simple for loop snippet"
	},
	"label": {
		"prefix": "label",
		"body": [
			"label ${1:labelName}:",
			"\t$0"
