{
    "name": "language-renpy-v2",
    "displayName": "vscode-language-renpy-v2",
    "description": "An attempt at re-creating and improving the current official vscode renpy extension",
    "version": "0.0.1",
    "publisher": "Hollow1",
    "repository": {
        "type": "git",
        "url": "https://github.com/Ho11ow1/language-renpy-v2.git"
    },
    "license": "MIT",
    "icon": "./renpy.png",
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "workspaceContains:**/*.rpy",
        "workspaceContains:**/*_ren.py"
    ],
    "contributes": {
        "languages": [
            {
                "id": "renpy",
                "aliases": [
                    "Ren'Py",
                    "renpy"
                ],
                "extensions": [
                    ".rpy",
                    ".rpym",
                    ".rpymc",
                    ".rpyc"
                ],
                "filenamePatterns": [
                    "*.rpy",
                    "*.rpym"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "dark": "./renpy.svg",
                    "light": "./renpy.svg"
                }
            }
        ],
        "configurationDefaults": {
            "[renpy]": {
                "editor.insertSpaces": true,
                "editor.tabSize": 4,
                "editor.detectIndentation": false
            }
        },
        "configuration": {
            "title": "Ren'Py v2",
            "properties": {
                "renpy.diagnosticsEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Dictates whether or not the extension will provide diagnostic information"
                },
                "renpy.limitedPythonRoot": {
                    "type": "boolean",
                    "default": false,
                    "description": "Dictates whether or not the immediate python functions should be limited to a common subset or not"
                },
                "renpy.sdkPath": {
                    "type": "string",
                    "default": "",
                    "description": "Should be an absolute path to your renpy sdk | Example: E:\\renpy-8.5.0-sdk"
                },
                "renpy.debuggerEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Dictates whether or not a simple debugger is enabled | Allows you to launch, restart & close your game from vscode"
                }
            }
        },
        "commands": [
            {
                "command": "renpy.toUpper",
                "title": "To Uppercase",
                "category": "Renpy-v2"
            },
            {
                "command": "renpy.toLower",
                "title": "To Lowercase",
                "category": "Renpy-v2"
            },
            {
                "command": "renpy.addItalic",
                "title": "Add Italics",
                "category": "Renpy-v2"
            },
            {
                "command": "renpy.addBold",
                "title": "Add Bold",
                "category": "Renpy-v2"
            },
            {
                "command": "renpy.addColor",
                "title": "Add Color",
                "category": "Renpy-v2"
            },
            {
                "command": "renpy.addCPS",
                "title": "Add CPS",
                "category": "Renpy-v2"
            },
            {
                "command": "renpy.processRun",
                "title": "Spawn game process",
                "category": "Renpy-v2"
            },
            {
                "command": "renpy.crawlDocs",
                "title": "Crawl sdk path docs",
                "category": "Renpy-v2"
            }
        ],
        "keybindings": [
            {
                "command": "renpy.processRun",
                "key": "F5",
                "when": "resourceLangId == renpy"
            }
        ],
        "submenus": [
            {
                "id": "renpy.submenu",
                "label": "Ren'Py"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "submenu": "renpy.submenu",
                    "group": "navigation@1",
                    "when": "resourceLangId == renpy || resourceExtname == .rpy"
                }
            ],
            "renpy.submenu": [
                {
                    "command": "renpy.toUpper"
                },
                {
                    "command": "renpy.toLower"
                },
                {
                    "command": "renpy.addItalic"
                },
                {
                    "command": "renpy.addBold"
                },
                {
                    "command": "renpy.addColor"
                },
                {
                    "command": "renpy.addCPS"
                }
            ]
        },
        "debuggers": [
            {
                "type": "renpy",
                "label": "Ren'Py",
                "languages": [
                    "renpy"
                ]
            }
        ],
        "grammars": [
            {
                "language": "renpy",
                "scopeName": "source.renpy",
                "path": "./syntaxes/renpy.tmLanguage.json"
            },
            {
                "scopeName": "source.renpy.screen",
                "path": "./syntaxes/renpy.screen.tmLanguage.json"
            },
            {
                "scopeName": "source.renpy.style",
                "path": "./syntaxes/renpy.style.tmLanguage.json"
            },
            {
                "scopeName": "source.renpy.atl",
                "path": "./syntaxes/renpy.atl.tmLanguage.json"
            },
            {
                "scopeName": "source.renpy.test",
                "path": "./syntaxes/renpy.test.tmLanguage.json"
            },
            {
                "scopeName": "source.renpy.python",
                "path": "./syntaxes/renpy.python.tmLanguage.json"
            },
            {
                "scopeName": "renpy.comment.injection",
                "path": "./syntaxes/renpy.injection.json",
                "injectTo": [
                    "source.python"
                ],
                "embeddedLanguages": {
                    "meta.embedded.renpy": "renpy"
                }
            },
            {
                "scopeName": "markdown.renpy.codeblock",
                "path": "./syntaxes/renpy.markdown.json",
                "injectTo": [
                    "text.html.markdown"
                ],
                "embeddedLanguages": {
                    "meta.embedded.renpy": "renpy"
                }
            },
            {
                "scopeName": "text.log.injection",
                "path": "./syntaxes/log.injection.json",
                "injectTo": [
                    "text.log"
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
        "vscode:package": "pnpm run package && vsce package",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "@types/vscode": "^1.125.0",
        "@vscode/debugprotocol": "^1.68.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.1",
        "eslint": "^10.5.0",
        "npm-run-all": "^4.1.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    }
}
