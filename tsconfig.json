{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": [
        "ES2022"
    ],
    "types": [
        "node", 
        "mocha"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,

    "paths": {
      "@src/*": ["./src/*"],
      "@utils/*": ["./src/utils/*"],
      "@common/*": ["./src/common/*"],
      "@models/*": ["./src/models/*"],
      "@interfaces/*": ["./src/interfaces/*"],
      "@data/*": ["./src/data/*"],
      "@parser/*": ["./src/parser/*"],
    }
  }
}
