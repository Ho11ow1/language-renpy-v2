{
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node", "mocha"],
        "sourceMap": false,
        "rootDir": "src",
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "resolveJsonModule": true,

        "paths": {
            "@src/*": ["./src/*"],
            "@common/*": ["./src/common/*"],
            "@config/*": ["./src/config/*"],
            "@data/*": ["./src/data/*"],
            "@interfaces/*": ["./src/interfaces/*"],
            "@models/*": ["./src/models/*"],
            "@parser/*": ["./src/parser/*"],
            "@services/*": ["./src/services/*"],
            "@utils/*": ["./src/utils/*"]
        }
    }
}
