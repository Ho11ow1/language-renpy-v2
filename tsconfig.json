{
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node"],
        "outDir": "out",
        "rootDir": ".",
        "sourceMap": false,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "resolveJsonModule": true,
        "paths": {
            "@client/*": ["./client/*"],
            "@server/*": ["./server/*"],
            "@common/*": ["./common/*"]
        },
    }
}
